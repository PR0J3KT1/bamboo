# Copy to .env.local for development. Never commit real values.

# Postgres (docker compose up -d gives you this one)
DATABASE_URL=postgres://bamboo:bamboo@localhost:5433/bamboo_cask

# Better Auth: a long random string (openssl rand -base64 32) and the site's public address
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Other addresses the site is served from, comma-separated (optional)
BETTER_AUTH_TRUSTED_ORIGINS=

# Africa's Talking SMS. Leave empty in development: sign-in codes are printed in the server log.
# AT_USERNAME=sandbox uses the sandbox API.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# TumaBoda partner API (riders for delivery orders). Leave empty to arrange riders by phone.
# Keys are issued by TumaBoda: tuma_test_… for the sandbox, tuma_live_… for live.
TUMABODA_API_KEY=
# Sandbox by default; live is https://api.tumaboda.co.ke/api/v1/partner
TUMABODA_BASE_URL=
# The whsec_… secret shown once when you add https://<site>/api/tumaboda/webhook in the TumaBoda business app
TUMABODA_WEBHOOK_SECRET=

# Cloudflare R2 for menu photos (any S3-compatible store works with R2_ENDPOINT in place of R2_ACCOUNT_ID).
# Leave empty in development: photos are saved in public/uploads.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public address: its r2.dev URL or a custom domain, e.g. https://photos.bamboocask.co.ke
R2_PUBLIC_URL=
